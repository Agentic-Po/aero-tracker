# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role JWT, NOT the anon key

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=@devAerodromeM     # public channel @username works; private group needs numeric -100xxxxxxxxxx

# Optional
COINGECKO_API_KEY=                  # blank uses public free tier; set if you hit rate limits
LIGHTPANDA_PATH=lightpanda          # override if not on PATH
DEBUG_DUMP_HTML=0                   # set to 1 to write the raw scraped HTML to debug_dumps/
